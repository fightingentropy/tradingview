{
  "name": "tradingview-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:convex": "CONVEX_NO_UPDATE_CHECK=true bun x convex dev --env-file .env.local --local",
    "dev:ui": "vite",
    "typecheck:ui": "tsc --noEmit -p tsconfig.json",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "typecheck": "bun run typecheck:ui && bun run typecheck:convex",
    "test": "bun test",
    "build": "vite build",
    "check": "bun run typecheck && bun run test && bun run build",
    "preview": "vite preview",
    "deploy:convex": "bash -lc \"export CONVEX_DEPLOYMENT=$(grep -m1 '^CONVEX_DEPLOYMENT=' .env.local | cut -d= -f2- | sed -E 's/[[:space:]]+#.*$//'); CONVEX_NO_UPDATE_CHECK=true bun x convex deploy\"",
    "migrate:accounting:prod": "bun run scripts/backfill-accounting-production.ts --confirm-production"
  },
  "dependencies": {
    "@nktkas/hyperliquid": "0.33.3",
    "convex": "1.43.0",
    "lightweight-charts": "^5.1.0",
    "solid-js": "1.9.15",
    "viem": "2.56.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.2.0",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^7.0.2",
    "vite": "^6.4.1",
    "vite-plugin-solid": "^2.11.10"
  }
}
