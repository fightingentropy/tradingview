{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tradingview-news-relay",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "PRICE_ALERTS", "class_name": "MacMiniAlertRelay" }]
  },
  "migrations": [{ "tag": "price-alerts-v1", "new_sqlite_classes": ["MacMiniAlertRelay"] }],
  "kv_namespaces": [
    {
      "binding": "NEWS_RELAY_KV",
      "id": "757a63280fc54505ad9c6950b37df7b6"
    }
  ],
  "secrets": {
    "required": ["APP_ACCESS_TOKEN", "BRIDGE_SECRET", "ANTHROPIC_API_KEY"]
  },
  // Weekday checks around the 09:35 and 16:05 New York pulse slots, in UTC for
  // both daylight-saving offsets; the Worker gates each run on the New York clock.
  "triggers": { "crons": ["*/5 13-21 * * 1-5"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
