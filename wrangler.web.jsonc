{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tradingview-web",
  "main": "worker/web-entry.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [
    { "binding": "DAILY_BRIEFS", "id": "a61b65da42314097857d47cc813a6d82" },
    // Read-only here: the news relay's feed is the brief's CT, Telegram, Digg and Paste Trade evidence.
    { "binding": "NEWS_RELAY_KV", "id": "757a63280fc54505ad9c6950b37df7b6" },
    // Sonnet summaries of reported $10B+ earnings, one entry per US trading day.
    { "binding": "EARNINGS_SUMMARIES", "id": "9a9394262805424dbaeec45c2e40010e" }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "workflows": [
    { "name": "tradingview-daily-brief", "binding": "DAILY_BRIEF_WORKFLOW", "class_name": "DailyBriefWorkflow" }
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "limits": { "cpu_ms": 300000 },
  "secrets": {
    "required": ["ANTHROPIC_API_KEY", "APP_ACCESS_TOKEN"]
  },
  "routes": [
    { "pattern": "trade.erlin.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/account", "/account/", "/economic-calendar", "/economic-calendar/", "/news", "/news/", "/markets", "/markets/", "/symbol/*"]
  },
  "observability": {
    "enabled": true
  }
}
