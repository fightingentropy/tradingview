{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tradingview-web",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-06",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/*.html"]
  },
  "observability": {
    "enabled": true
  }
}
