{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tradingview-web",
  "main": "worker/web-app.mjs",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "trade.erlin.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/account", "/account/", "/economic-calendar", "/economic-calendar/", "/news", "/news/", "/markets", "/markets/", "/symbol/*"]
  },
  "observability": {
    "enabled": true
  }
}
